<?xml version="1.0" encoding="UTF-8"?>

<!--
    Archivo de configuración principal de Maven.
    Aquí se definen:
    - La versión de Java
    - Las dependencias del proyecto
    - Los plugins de compilación
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<!-- Versión del modelo de Maven -->
	<modelVersion>4.0.0</modelVersion>

	<!-- Spring Boot como proyecto padre -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.1</version>
	</parent>

	<!-- Identificación del proyecto -->
	<groupId>com.example</groupId>
	<artifactId>sistemaInquilinos</artifactId>
	<version>0.0.1-SNAPSHOT</version>

	<!-- Versión de Java utilizada en el proyecto -->
	<properties>
		<java.version>21</java.version>
	</properties>

	<!-- ========================= -->
	<!-- DEPENDENCIAS DEL PROYECTO -->
	<!-- ========================= -->
	<dependencies>

		<!-- 🔹 Spring Boot Web
             Permite crear controladores REST (@RestController),
             recibir peticiones HTTP y devolver JSON -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- 🔐 Spring Security
             Se utiliza para:
             - Login
             - Autenticación
             - Autorización por roles
             - Protección de endpoints -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- 🗄️ Spring Data JPA
             Permite trabajar con la base de datos usando:
             - Repositorios
             - Entidades
             - Hibernate -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- ✅ Validaciones (como @NotBlank, @Min, @Max, etc.) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- 🐬 Conector de MySQL
             Permite que Spring se conecte con la base de datos -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- ⚡ Lombok
             Genera automáticamente:
             - Getters
             - Setters
             - Constructores
             - Builder
             Evita escribir código repetitivo -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>1.18.30</version>
			<scope>provided</scope>
		</dependency>

		<!-- 🔑 JWT API
             Permite generar y validar tokens JWT -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.11.5</version>
		</dependency>

		<!-- Implementación interna de JWT -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.11.5</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Conversión de JWT a JSON -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.11.5</version>
			<scope>runtime</scope>
		</dependency>

		<!-- 🧪 Test de Spring Boot -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- 🧪 Test específicos de Spring Security -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Dependencias de testing (solo para tests):
incluye JUnit 5 + Mockito + Spring Test para tests unitarios y de integración,
y se usa únicamente en src/test/java (no se empaqueta en producción). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>



	</dependencies>

	<!-- ================= -->
	<!-- CONFIGURACIÓN BUILD -->
	<!-- ================= -->
	<build>
		<plugins>

			<!-- ⚙️ Plugin compilador de Java
                 - Usa Java 21
                 - Soporte para Lombok -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.11.0</version>
				<configuration>
					<source>21</source>
					<target>21</target>

					<!-- Activación correcta de Lombok -->
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>1.18.30</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>

			<!-- 🚀 Plugin para ejecutar Spring Boot -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

		</plugins>
	</build>

</project>
